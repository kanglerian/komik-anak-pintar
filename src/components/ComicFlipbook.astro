---
import type { Comic } from '../lib/comics';

interface Props {
	comic: Comic;
}

const { comic } = Astro.props;
---

<div
	id="reader-stage"
	class="reader-stage relative flex flex-col items-center justify-between rounded-2xl bg-slate-900 p-3 sm:p-5 shadow-xl border border-slate-800"
	data-slug={comic.slug}
	data-total-pages={comic.pageCount}
	data-page-width={comic.width}
	data-page-height={comic.height}
	data-page-audios={JSON.stringify(comic.pageAudios)}
	data-narrations={JSON.stringify(comic.narrations)}
>
	<!-- Clean Minimalist Top Toolbar -->
	<div class="reader-topbar w-full flex flex-wrap items-center justify-between gap-2 pb-2.5 px-1 z-20">
		<div class="flex items-center gap-2">
			<span
				id="page-indicator"
				class="inline-flex items-center rounded-lg bg-slate-800 border border-slate-700 px-3 py-1.5 text-xs sm:text-sm font-bold text-slate-100"
			>
				Halaman 1 / {comic.pageCount}
			</span>
			<button
				id="btn-restart"
				type="button"
				title="Ulangi dari Halaman 1"
				class="hidden items-center gap-1 rounded-lg bg-slate-800 hover:bg-slate-700 border border-slate-700 active:scale-95 px-3 py-1.5 text-xs sm:text-sm font-semibold text-slate-200 transition cursor-pointer"
			>
				↺ Ulangi
			</button>
		</div>

		<div class="flex items-center gap-2">
			<!-- Page Audio / Narration Button (Auto-hidden when comic/page has no audio) -->
			<button
				id="btn-page-audio"
				type="button"
				aria-label="Dengarkan cerita halaman ini"
				class="hidden items-center gap-1.5 rounded-lg bg-amber-400 hover:bg-amber-300 active:scale-95 px-3 py-1.5 text-xs sm:text-sm font-bold text-slate-950 shadow-xs transition cursor-pointer"
			>
				<span id="page-audio-icon">▶️</span>
				<span id="page-audio-label">Dengarkan</span>
			</button>

			<!-- Thumbnail List Toggle -->
			<button
				id="btn-thumbs-toggle"
				type="button"
				class="inline-flex items-center gap-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 border border-slate-700 active:scale-95 px-3 py-1.5 text-xs sm:text-sm font-semibold text-slate-100 transition cursor-pointer"
			>
				<span>☷</span>
				<span class="hidden sm:inline">Halaman</span>
			</button>

			<!-- Sound Toggle -->
			<button
				id="btn-sound"
				type="button"
				aria-label="Aktifkan atau matikan efek suara buku"
				class="inline-flex items-center gap-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 border border-slate-700 active:scale-95 px-3 py-1.5 text-xs sm:text-sm font-semibold text-slate-100 transition cursor-pointer"
			>
				<span id="sound-icon">🔊</span>
				<span id="sound-label" class="hidden sm:inline">Suara</span>
			</button>

			<!-- Fullscreen Toggle -->
			<button
				id="btn-fullscreen"
				type="button"
				aria-label="Mode Layar Penuh"
				class="inline-flex items-center gap-1.5 rounded-lg bg-indigo-600 hover:bg-indigo-500 active:scale-95 px-3.5 py-1.5 text-xs sm:text-sm font-semibold text-white shadow-xs transition cursor-pointer"
			>
				<span id="fullscreen-icon">⛶</span>
				<span id="fullscreen-label">Layar Penuh</span>
			</button>
		</div>
	</div>

	<!-- Subtle Progress Bar -->
	<div class="reader-progress-track w-full h-1.5 bg-slate-800 rounded-full overflow-hidden mb-3">
		<div
			id="reading-progress"
			class="h-full bg-indigo-500 transition-all duration-300 rounded-full"
			style={`width: ${Math.max(5, Math.round((1 / comic.pageCount) * 100))}%`}
		>
		</div>
	</div>

	<!-- Main 16:9 Widescreen Book & Side Navigation Area -->
	<div class="flipbook-stage-area relative w-full flex items-center justify-center my-1">
		<!-- Side Prev Button (Desktop/Tablet) -->
		<button
			id="btn-prev-side"
			type="button"
			aria-label="Halaman Sebelumnya"
			class="reader-side-btn reader-side-prev hidden md:flex items-center justify-center w-11 h-11 rounded-full bg-slate-800/90 hover:bg-indigo-600 border border-slate-700 disabled:opacity-25 disabled:pointer-events-none text-white font-bold text-lg shadow-lg active:scale-95 transition z-20 mr-3 shrink-0 cursor-pointer"
		>
			❮
		</button>

		<!-- 3D Flipbook 16:9 Container -->
		<div
			id="flipbook-viewport"
			class="flipbook-wrapper w-full flex items-center justify-center overflow-hidden"
		>
			<div id="comic-book" class="w-full mx-auto select-none">
				{
					comic.pages.map((pageUrl, idx) => (
						<div
							class="comic-page relative bg-slate-950 flex items-center justify-center rounded-lg overflow-hidden"
							data-density="soft"
						>
							<img
								src={pageUrl}
								alt={`${comic.title} - Halaman ${idx + 1}`}
								loading={idx < 4 ? 'eager' : 'lazy'}
								draggable="false"
								class="w-full h-full object-contain pointer-events-none select-none"
							/>
							<span class="absolute bottom-2.5 right-3 rounded-md bg-slate-900/75 px-2.5 py-0.5 text-xs font-semibold text-slate-200 backdrop-blur-xs pointer-events-none">
								{idx + 1} / {comic.pageCount}
							</span>
						</div>
					))
				}
			</div>
		</div>

		<!-- Side Next Button (Desktop/Tablet) -->
		<button
			id="btn-next-side"
			type="button"
			aria-label="Halaman Berikutnya"
			class="reader-side-btn reader-side-next hidden md:flex items-center justify-center w-11 h-11 rounded-full bg-slate-800/90 hover:bg-indigo-600 border border-slate-700 disabled:opacity-25 disabled:pointer-events-none text-white font-bold text-lg shadow-lg active:scale-95 transition z-20 ml-3 shrink-0 cursor-pointer"
		>
			❯
		</button>
	</div>

	<!-- Bottom Controls & Thumbnail Drawer -->
	<div class="reader-bottombar w-full flex flex-col items-center gap-2.5 pt-3 z-20">
		<div class="reader-bottom-nav flex items-center justify-center gap-2.5 sm:gap-3 w-full max-w-md">
			<button
				id="btn-prev-bottom"
				type="button"
				class="flex-1 inline-flex items-center justify-center gap-1.5 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-700 disabled:opacity-35 disabled:pointer-events-none active:scale-95 px-3.5 sm:px-4 py-2 sm:py-2.5 text-xs sm:text-sm font-semibold text-white whitespace-nowrap transition cursor-pointer"
			>
				← Sebelumnya
			</button>

			<button
				id="btn-next-bottom"
				type="button"
				class="flex-1 inline-flex items-center justify-center gap-1.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 disabled:opacity-35 disabled:pointer-events-none active:scale-95 px-3.5 sm:px-4 py-2 sm:py-2.5 text-xs sm:text-sm font-semibold text-white whitespace-nowrap shadow-sm transition cursor-pointer"
			>
				Berikutnya →
			</button>
		</div>

		<p class="reader-hint text-xs text-slate-400 text-center">
			Tips: Geser gambar atau tarik ujung halaman untuk membalik lembar komik
		</p>

		<!-- Collapsible 16:9 Thumbnail Strip -->
		<div
			id="thumbs-drawer"
			class="hidden w-full overflow-x-auto rounded-xl bg-slate-950/90 p-3 border border-slate-800 mt-1"
		>
			<div class="flex items-center gap-2.5 min-w-max">
				{
					comic.pages.map((pageUrl, idx) => (
						<button
							type="button"
							data-jump-page={idx}
							class="thumb-item group relative flex flex-col items-center rounded-lg overflow-hidden border-2 border-transparent hover:border-indigo-400 transition focus:outline-none cursor-pointer"
						>
							<img
								src={pageUrl}
								alt={`Halaman ${idx + 1}`}
								loading="lazy"
								class="w-28 aspect-video object-cover bg-slate-900"
							/>
							<span class="w-full bg-slate-900 text-[11px] font-semibold text-slate-200 py-1 text-center">
								Hal {idx + 1}
							</span>
						</button>
					))
				}
			</div>
		</div>
	</div>
</div>

<script>
	import { PageFlip } from 'page-flip';

	function initComicReader() {
		const stage = document.getElementById('reader-stage');
		const viewport = document.getElementById('flipbook-viewport');
		const bookEl = document.getElementById('comic-book');
		if (!stage || !viewport || !bookEl) return;

		const slug = stage.dataset.slug || 'default';
		const totalPages = Number(stage.dataset.totalPages || 1);
		const pageWidth = Number(stage.dataset.pageWidth || 1280);
		const pageHeight = Number(stage.dataset.pageHeight || 720);
		const aspectRatio = pageWidth / pageHeight; // 16:9 (1.7778)

		let pageAudios: Array<string | null> = [];
		let narrations: Array<string | null> = [];
		try {
			pageAudios = JSON.parse(stage.dataset.pageAudios || '[]');
			narrations = JSON.parse(stage.dataset.narrations || '[]');
		} catch {
			pageAudios = [];
			narrations = [];
		}

		const bookmarkKey = `komik_bookmark_${slug}`;
		const soundKey = 'komik_sound_enabled';

		let soundEnabled = localStorage.getItem(soundKey) !== 'false';
		let audioCtx: AudioContext | null = null;
		let currentAudio: HTMLAudioElement | null = null;
		let isPlayingPageAudio = false;
		let activePageIndex = 0;

		function playPageFlipSound() {
			if (!soundEnabled) return;
			try {
				const AudioContextClass =
					window.AudioContext ||
					(window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
				if (!audioCtx) {
					audioCtx = new AudioContextClass();
				}
				if (audioCtx.state === 'suspended') {
					audioCtx.resume();
				}

				const duration = 0.2;
				const bufferSize = audioCtx.sampleRate * duration;
				const buffer = audioCtx.createBuffer(1, bufferSize, audioCtx.sampleRate);
				const data = buffer.getChannelData(0);

				for (let i = 0; i < bufferSize; i++) {
					const t = i / bufferSize;
					const env = Math.sin(t * Math.PI) * Math.pow(1 - t, 0.7);
					data[i] = (Math.random() * 2 - 1) * env * 0.22;
				}

				const noise = audioCtx.createBufferSource();
				noise.buffer = buffer;

				const filter = audioCtx.createBiquadFilter();
				filter.type = 'bandpass';
				filter.frequency.setValueAtTime(900, audioCtx.currentTime);
				filter.frequency.exponentialRampToValueAtTime(2100, audioCtx.currentTime + duration);
				filter.Q.value = 1.4;

				const gain = audioCtx.createGain();
				gain.gain.setValueAtTime(0.01, audioCtx.currentTime);
				gain.gain.linearRampToValueAtTime(0.3, audioCtx.currentTime + 0.04);
				gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + duration);

				noise.connect(filter);
				filter.connect(gain);
				gain.connect(audioCtx.destination);

				noise.start();
			} catch {
				// Ignore audio errors if blocked by browser autoplay policy
			}
		}

		const savedPage = Math.min(
			Math.max(0, Number(localStorage.getItem(bookmarkKey) || 0)),
			totalPages - 1
		);

		const pageFlip = new PageFlip(bookEl, {
			width: pageWidth,
			height: pageHeight,
			size: 'stretch',
			minWidth: 280,
			maxWidth: 2560,
			minHeight: 158,
			maxHeight: 1440,
			maxShadowOpacity: 0.45,
			showCover: false,
			usePortrait: true,
			mobileScrollSupport: false,
			flippingTime: 600,
			startPage: savedPage,
			drawShadow: true,
		});

		const pages = bookEl.querySelectorAll('.comic-page');
		pageFlip.loadFromHTML(pages as NodeListOf<HTMLElement>);

		// Fix StPageFlip wrapper height & single-page 16:9 bounds so it scales cleanly in normal & Fullscreen modes
		const render = pageFlip.getRender() as unknown as {
			getBlockWidth: () => number;
			getBlockHeight: () => number;
			boundsRect: { left: number; top: number; width: number; height: number; pageWidth: number };
			calculateBoundsRect: () => string;
		};

		function isFullscreenActive() {
			const doc = document as Document & { webkitFullscreenElement?: Element | null };
			return Boolean(
				doc.fullscreenElement ||
					doc.webkitFullscreenElement ||
					stage?.classList.contains('is-pseudo-fullscreen')
			);
		}

		function resizeBookToFit() {
			const wrapperEl = bookEl?.querySelector('.stf__wrapper') as HTMLElement | null;
			if (!wrapperEl || !viewport) return;

			const isFullscreen = isFullscreenActive();

			let targetWidth: number;
			let targetHeight: number;

			if (isFullscreen) {
				// In fullscreen, controls float and auto-hide, so the 16:9 comic fills the screen
				const maxW = Math.max(280, window.innerWidth - 20);
				const maxH = Math.max(200, window.innerHeight - 16);
				targetWidth = maxW;
				targetHeight = Math.round(targetWidth / aspectRatio);
				if (targetHeight > maxH) {
					targetHeight = maxH;
					targetWidth = Math.round(targetHeight * aspectRatio);
				}
			} else {
				const availWidth = viewport.clientWidth;
				targetWidth = availWidth;
				targetHeight = Math.round(targetWidth / aspectRatio);
			}

			// Override StPageFlip's default 28.125% dual-spread paddingBottom with exact 16:9 height
			wrapperEl.style.paddingBottom = '0px';
			wrapperEl.style.width = `${targetWidth}px`;
			wrapperEl.style.height = `${targetHeight}px`;
			wrapperEl.style.margin = '0 auto';
		}

		if (render) {
			render.calculateBoundsRect = function () {
				resizeBookToFit();
				const blockWidth = this.getBlockWidth();
				const blockHeight = this.getBlockHeight();
				const middleX = blockWidth / 2;
				const middleY = blockHeight / 2;

				let h = blockWidth;
				let r = h / aspectRatio;
				if (r > blockHeight) {
					r = blockHeight;
					h = r * aspectRatio;
				}

				const left = middleX - h / 2 - h;
				this.boundsRect = {
					left,
					top: middleY - r / 2,
					width: 2 * h,
					height: r,
					pageWidth: h,
				};
				return 'portrait';
			};
			pageFlip.update();
		}

		window.addEventListener('resize', () => {
			resizeBookToFit();
			pageFlip.update();
		});

		// UI Elements
		const topbar = stage.querySelector('.reader-topbar') as HTMLElement | null;
		const bottombar = stage.querySelector('.reader-bottombar') as HTMLElement | null;
		const pageIndicator = document.getElementById('page-indicator');
		const progressBar = document.getElementById('reading-progress');
		const btnRestart = document.getElementById('btn-restart');
		const btnPrevSide = document.getElementById('btn-prev-side') as HTMLButtonElement | null;
		const btnNextSide = document.getElementById('btn-next-side') as HTMLButtonElement | null;
		const btnPrevBottom = document.getElementById('btn-prev-bottom') as HTMLButtonElement | null;
		const btnNextBottom = document.getElementById('btn-next-bottom') as HTMLButtonElement | null;
		const btnSound = document.getElementById('btn-sound');
		const soundIcon = document.getElementById('sound-icon');
		const soundLabel = document.getElementById('sound-label');
		const btnPageAudio = document.getElementById('btn-page-audio');
		const pageAudioIcon = document.getElementById('page-audio-icon');
		const pageAudioLabel = document.getElementById('page-audio-label');
		const btnFullscreen = document.getElementById('btn-fullscreen');
		const fullscreenIcon = document.getElementById('fullscreen-icon');
		const fullscreenLabel = document.getElementById('fullscreen-label');
		const btnThumbsToggle = document.getElementById('btn-thumbs-toggle');
		const thumbsDrawer = document.getElementById('thumbs-drawer');
		const thumbButtons = document.querySelectorAll<HTMLButtonElement>('[data-jump-page]');

		function hasPageAudio(pageIdx: number): boolean {
			return Boolean(pageAudios[pageIdx] || narrations[pageIdx]);
		}

		function updatePageAudioButtonUI(playing: boolean) {
			isPlayingPageAudio = playing;
			if (!btnPageAudio || !pageAudioIcon || !pageAudioLabel) return;
			if (playing) {
				pageAudioIcon.textContent = '⏹️';
				pageAudioLabel.textContent = 'Hentikan';
				btnPageAudio.classList.remove('bg-amber-400', 'hover:bg-amber-300');
				btnPageAudio.classList.add('bg-rose-500', 'hover:bg-rose-400', 'text-white');
			} else {
				pageAudioIcon.textContent = '▶️';
				pageAudioLabel.textContent = 'Dengarkan';
				btnPageAudio.classList.add('bg-amber-400', 'hover:bg-amber-300');
				btnPageAudio.classList.remove('bg-rose-500', 'hover:bg-rose-400', 'text-white');
			}
		}

		function stopPageAudio() {
			if (currentAudio) {
				currentAudio.pause();
				currentAudio.currentTime = 0;
				currentAudio = null;
			}
			if (typeof window !== 'undefined' && 'speechSynthesis' in window) {
				window.speechSynthesis.cancel();
			}
			updatePageAudioButtonUI(false);
		}

		function playPageAudio(pageIdx: number) {
			stopPageAudio();
			if (!hasPageAudio(pageIdx)) return;

			const audioUrl = pageAudios[pageIdx];
			const narrationText = narrations[pageIdx];

			if (audioUrl) {
				const audio = new Audio(audioUrl);
				currentAudio = audio;
				updatePageAudioButtonUI(true);
				audio.addEventListener('ended', () => {
					if (currentAudio === audio) {
						currentAudio = null;
						updatePageAudioButtonUI(false);
					}
				});
				audio.addEventListener('error', () => {
					if (currentAudio === audio) {
						currentAudio = null;
						updatePageAudioButtonUI(false);
					}
				});
				audio.play().catch(() => {
					if (currentAudio === audio) {
						currentAudio = null;
						updatePageAudioButtonUI(false);
					}
				});
			} else if (narrationText && typeof window !== 'undefined' && 'speechSynthesis' in window) {
				const utterance = new SpeechSynthesisUtterance(narrationText);
				utterance.lang = 'id-ID';
				utterance.rate = 0.95;
				utterance.pitch = 1.05;
				utterance.onstart = () => updatePageAudioButtonUI(true);
				utterance.onend = () => updatePageAudioButtonUI(false);
				utterance.onerror = () => updatePageAudioButtonUI(false);
				window.speechSynthesis.speak(utterance);
			}
		}

		// Auto-hide controls in Fullscreen mode
		let controlsHideTimer: ReturnType<typeof setTimeout> | null = null;
		let isHoveringControls = false;

		function clearControlsTimer() {
			if (controlsHideTimer) {
				clearTimeout(controlsHideTimer);
				controlsHideTimer = null;
			}
		}

		function showFullscreenControls() {
			stage?.classList.remove('fs-controls-hidden');
			clearControlsTimer();

			if (!isFullscreenActive()) return;

			const isDrawerOpen = thumbsDrawer && !thumbsDrawer.classList.contains('hidden');
			if (isHoveringControls || isDrawerOpen) return;

			controlsHideTimer = setTimeout(() => {
				const drawerStillOpen = thumbsDrawer && !thumbsDrawer.classList.contains('hidden');
				if (isFullscreenActive() && !isHoveringControls && !drawerStillOpen) {
					stage?.classList.add('fs-controls-hidden');
				}
			}, 2400);
		}

		[topbar, bottombar, btnPrevSide, btnNextSide].forEach((el) => {
			if (!el) return;
			el.addEventListener(' pointerenter', () => {
				isHoveringControls = true;
				showFullscreenControls();
			});
			el.addEventListener('mouseenter', () => {
				isHoveringControls = true;
				showFullscreenControls();
			});
			el.addEventListener('mouseleave', () => {
				isHoveringControls = false;
				showFullscreenControls();
			});
		});

		stage.addEventListener('mousemove', () => {
			if (isFullscreenActive()) showFullscreenControls();
		});
		stage.addEventListener('touchstart', () => {
			if (isFullscreenActive()) showFullscreenControls();
		}, { passive: true });
		stage.addEventListener('click', () => {
			if (isFullscreenActive()) showFullscreenControls();
		});

		function updateSoundButtonUI() {
			if (!soundIcon || !btnSound) return;
			if (soundEnabled) {
				soundIcon.textContent = '🔊';
				if (soundLabel) soundLabel.textContent = 'Suara';
				btnSound.classList.remove('opacity-60');
			} else {
				soundIcon.textContent = '🔇';
				if (soundLabel) soundLabel.textContent = 'Bisu';
				btnSound.classList.add('opacity-60');
			}
		}

		function updateUI(currentIndex: number, autoPlayAudio = false) {
			activePageIndex = currentIndex;
			const currentNum = currentIndex + 1;
			if (pageIndicator) {
				pageIndicator.textContent = `Halaman ${currentNum} / ${totalPages}`;
			}

			if (progressBar) {
				const pct = Math.max(5, Math.round((currentNum / totalPages) * 100));
				progressBar.style.width = `${pct}%`;
			}

			if (btnRestart) {
				if (currentIndex > 0) {
					btnRestart.classList.remove('hidden');
					btnRestart.classList.add('inline-flex');
				} else {
					btnRestart.classList.add('hidden');
					btnRestart.classList.remove('inline-flex');
				}
			}

			// Tampilkan atau sembunyikan tombol Dengarkan secara fleksibel sesuai ketersediaan audio halaman
			stopPageAudio();
			if (btnPageAudio) {
				if (hasPageAudio(currentIndex)) {
					btnPageAudio.classList.remove('hidden');
					btnPageAudio.classList.add('inline-flex');
					if (autoPlayAudio && soundEnabled) {
						playPageAudio(currentIndex);
					}
				} else {
					btnPageAudio.classList.add('hidden');
					btnPageAudio.classList.remove('inline-flex');
				}
			}

			const isFirst = currentIndex <= 0;
			const isLast = currentIndex >= totalPages - 1;

			if (btnPrevSide) btnPrevSide.disabled = isFirst;
			if (btnPrevBottom) btnPrevBottom.disabled = isFirst;
			if (btnNextSide) btnNextSide.disabled = isLast;
			if (btnNextBottom) btnNextBottom.disabled = isLast;

			// Highlight active thumbnail
			thumbButtons.forEach((btn) => {
				const idx = Number(btn.dataset.jumpPage);
				if (idx === currentIndex) {
					btn.classList.add('border-indigo-500', 'ring-2', 'ring-indigo-500');
					btn.classList.remove('border-transparent');
				} else {
					btn.classList.remove('border-indigo-500', 'ring-2', 'ring-indigo-500');
					btn.classList.add('border-transparent');
				}
			});

			// Save bookmark to localStorage
			localStorage.setItem(bookmarkKey, String(currentIndex));
		}

		updateSoundButtonUI();
		updateUI(savedPage, false);

		// Listen to flip events
		pageFlip.on('flip', (e) => {
			const pageIdx = Number(e.data);
			playPageFlipSound();
			updateUI(pageIdx, true);
		});

		// Navigation Buttons
		btnPrevSide?.addEventListener('click', () => pageFlip.flipPrev());
		btnPrevBottom?.addEventListener('click', () => pageFlip.flipPrev());
		btnNextSide?.addEventListener('click', () => pageFlip.flipNext());
		btnNextBottom?.addEventListener('click', () => pageFlip.flipNext());

		btnRestart?.addEventListener('click', () => {
			pageFlip.flip(0);
		});

		// Page Audio Play/Stop Button
		btnPageAudio?.addEventListener('click', () => {
			if (isPlayingPageAudio) {
				stopPageAudio();
			} else {
				playPageAudio(activePageIndex);
			}
		});

		// Sound Toggle
		btnSound?.addEventListener('click', () => {
			soundEnabled = !soundEnabled;
			localStorage.setItem(soundKey, String(soundEnabled));
			updateSoundButtonUI();
			if (soundEnabled) {
				playPageFlipSound();
			} else {
				stopPageAudio();
			}
		});

		window.addEventListener('pagehide', stopPageAudio);
		window.addEventListener('beforeunload', stopPageAudio);

		function syncFullscreenState() {
			const active = isFullscreenActive();
			stage?.classList.toggle('is-fullscreen', active);
			document.body.classList.toggle('overflow-hidden', active);

			if (fullscreenLabel) {
				fullscreenLabel.textContent = active ? 'Keluar Penuh' : 'Layar Penuh';
			}
			if (fullscreenIcon) {
				fullscreenIcon.textContent = active ? '✕' : '⛶';
			}

			if (active) {
				showFullscreenControls();
			} else {
				clearControlsTimer();
				stage?.classList.remove('fs-controls-hidden');
			}

			// Recalculate dimensions immediately and after transition completes
			resizeBookToFit();
			pageFlip.update();
			setTimeout(() => {
				resizeBookToFit();
				pageFlip.update();
			}, 120);
		}

		async function toggleFullscreen() {
			const doc = document as Document & {
				webkitFullscreenElement?: Element | null;
				webkitExitFullscreen?: () => Promise<void>;
			};
			const el = stage as HTMLElement & {
				webkitRequestFullscreen?: () => Promise<void>;
			};
			if (!el) return;

			if (isFullscreenActive()) {
				if (el.classList.contains('is-pseudo-fullscreen')) {
					el.classList.remove('is-pseudo-fullscreen');
					syncFullscreenState();
					return;
				}
				try {
					if (doc.exitFullscreen) {
						await doc.exitFullscreen();
					} else if (doc.webkitExitFullscreen) {
						await doc.webkitExitFullscreen();
					}
				} catch {
					el.classList.remove('is-pseudo-fullscreen');
					syncFullscreenState();
				}
			} else {
				try {
					if (el.requestFullscreen) {
						await el.requestFullscreen();
					} else if (el.webkitRequestFullscreen) {
						await el.webkitRequestFullscreen();
					} else {
						el.classList.add('is-pseudo-fullscreen');
						syncFullscreenState();
					}
				} catch {
					// Fallback to CSS fullscreen (e.g., iOS Safari)
					el.classList.add('is-pseudo-fullscreen');
					syncFullscreenState();
				}
			}
		}

		// Fullscreen Toggle
		btnFullscreen?.addEventListener('click', () => {
			toggleFullscreen();
		});

		document.addEventListener('fullscreenchange', syncFullscreenState);
		document.addEventListener('webkitfullscreenchange', syncFullscreenState);

		// Thumbnail Drawer Toggle & Jump
		btnThumbsToggle?.addEventListener('click', () => {
			thumbsDrawer?.classList.toggle('hidden');
			showFullscreenControls();
			setTimeout(() => {
				resizeBookToFit();
				pageFlip.update();
			}, 50);
		});

		thumbButtons.forEach((btn) => {
			btn.addEventListener('click', () => {
				const targetPage = Number(btn.dataset.jumpPage || 0);
				pageFlip.flip(targetPage);
				if (isFullscreenActive()) {
					thumbsDrawer?.classList.add('hidden');
					showFullscreenControls();
				}
			});
		});

		// Keyboard navigation & shortcuts
		window.addEventListener('keydown', (e) => {
			if (e.key === 'ArrowRight') {
				pageFlip.flipNext();
				if (isFullscreenActive()) showFullscreenControls();
			} else if (e.key === 'ArrowLeft') {
				pageFlip.flipPrev();
				if (isFullscreenActive()) showFullscreenControls();
			} else if (e.key === 'f' || e.key === 'F') {
				e.preventDefault();
				toggleFullscreen();
			} else if (e.key === 'Escape' && stage.classList.contains('is-pseudo-fullscreen')) {
				stage.classList.remove('is-pseudo-fullscreen');
				syncFullscreenState();
			}
		});
	}

	initComicReader();
</script>
