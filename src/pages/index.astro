---
import Layout from '../layouts/Layout.astro';
import { getAllComics } from '../lib/comics';

const comics = getAllComics();
---

<Layout title="APin (Komik Anak Pintar) — Pilih Komik">
	<!-- Cheerful & Simple Kids Hero Section with Playful Ornaments -->
	<section class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-indigo-600 via-violet-600 to-sky-500 text-white p-6 sm:p-10 mb-8 shadow-md border-b-4 border-amber-300">
		<!-- Simple Decorative Ornaments (Stars, Clouds, Bubbles) -->
		<div class="pointer-events-none select-none" aria-hidden="true">
			<!-- Soft glowing circles -->
			<div class="absolute -top-12 -right-12 w-44 h-44 rounded-full bg-amber-300/25 blur-xl"></div>
			<div class="absolute -bottom-14 right-1/4 w-40 h-40 rounded-full bg-sky-300/20 blur-xl"></div>

			<!-- Simple Stars & Shapes -->
			<svg class="absolute top-5 right-8 sm:right-64 w-6 h-6 text-amber-300 animate-pulse" viewBox="0 0 24 24" fill="currentColor">
				<path d="M12 2l2.6 6.6L21 9.5l-5 4.4 1.5 6.6L12 17l-5.5 3.5L8 13.9 3 9.5l6.4-.9L12 2z" />
			</svg>
			<svg class="hidden sm:block absolute bottom-6 right-56 w-5 h-5 text-rose-300" viewBox="0 0 24 24" fill="currentColor">
				<circle cx="12" cy="12" r="8" />
			</svg>
			<svg class="hidden sm:block absolute top-10 right-14 w-5 h-5 text-emerald-300" viewBox="0 0 24 24" fill="currentColor">
				<path d="M12 2C13.5 7.5 16.5 10.5 22 12C16.5 13.5 13.5 16.5 12 22C10.5 16.5 7.5 13.5 2 12C7.5 10.5 10.5 7.5 12 2Z" />
			</svg>

			<!-- Simple Cute Cloud Ornament at Bottom Right -->
			<svg class="hidden md:block absolute -bottom-3 right-6 w-44 h-24 text-white/15" viewBox="0 0 200 100" fill="currentColor">
				<path d="M45 90h115c20 0 35-15 35-35 0-18-13-32-30-34C158 8 143 0 126 0c-22 0-40 15-44 36-5-3-11-5-17-5-18 0-33 14-34 32C18 66 10 77 10 90h35z" />
			</svg>
		</div>

		<div class="relative z-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
			<div class="max-w-2xl">
				<span class="inline-flex items-center gap-1.5 rounded-full bg-amber-300 text-slate-900 px-3.5 py-1 text-xs font-extrabold tracking-wide uppercase mb-3 shadow-2xs">
					<span>✨</span>
					<span>APin • Komik Anak Pintar</span>
				</span>
				<h1 class="text-2xl sm:text-4xl font-bold tracking-tight mb-2.5 drop-shadow-2xs">
					Pilih Cerita & Balik Halamannya!
				</h1>
				<p class="text-sm sm:text-base text-indigo-50 leading-relaxed">
					Sentuh dan geser ujung gambar komik untuk membalik halaman persis seperti membaca buku cerita sungguhan.
				</p>
			</div>

			<!-- Simple Cheerful Badge Ornaments on Desktop -->
			<div class="hidden md:flex items-center gap-3 shrink-0 pr-2" aria-hidden="true">
				<div class="w-16 h-16 rounded-2xl bg-amber-300 text-slate-900 flex items-center justify-center text-3xl shadow-lg -rotate-6 border-2 border-white/80">
					📖
				</div>
				<div class="w-14 h-14 rounded-2xl bg-rose-400 text-white flex items-center justify-center text-2xl shadow-lg rotate-6 border-2 border-white/80">
					🌟
				</div>
			</div>
		</div>
	</section>

	<!-- Rak Buku Komik -->
	<section>
		<div class="flex items-center justify-between gap-3 mb-5">
			<div>
				<h2 class="text-xl sm:text-2xl font-bold text-slate-900 flex items-center gap-2">
					<span>🎨</span>
					<span>Koleksi Komik</span>
				</h2>
				<p class="text-sm text-slate-600">
					Pilih salah satu judul di bawah ini untuk mulai membaca
				</p>
			</div>
		</div>

		{
			comics.length === 0 ? (
				<div class="rounded-2xl border-2 border-dashed border-amber-300 bg-white/90 p-10 text-center">
					<h3 class="text-lg font-bold text-slate-900 mb-1">Belum Ada Komik</h3>
					<p class="text-sm text-slate-600 max-w-md mx-auto">
						Buat folder di dalam <code class="bg-slate-100 px-1.5 py-0.5 rounded font-mono">public/comics/nama-komik/</code> lalu masukkan file gambar <code class="bg-slate-100 px-1.5 py-0.5 rounded font-mono">.webp</code>.
					</p>
				</div>
			) : (
				<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
					{comics.map((comic) => (
						<a
							href={`/komik/${comic.slug}`}
							data-comic-card={comic.slug}
							data-total-pages={comic.pageCount}
							class="group flex flex-col rounded-2xl border-2 border-amber-200/80 bg-white overflow-hidden shadow-xs hover:shadow-xl hover:-translate-y-1 hover:border-amber-400 transition-all duration-200"
						>
							<!-- 16:9 Cover Preview -->
							<div class="relative aspect-video w-full bg-slate-900 overflow-hidden">
								<img
									src={comic.coverUrl}
									alt={`Sampul ${comic.title}`}
									loading="lazy"
									class="w-full h-full object-cover group-hover:scale-103 transition-transform duration-300"
								/>

								<!-- Top Page Count & Optional Audio Badge -->
								<div class="absolute top-3 right-3 flex items-center gap-1.5">
									{comic.hasAudio && (
										<span class="rounded-lg bg-amber-400 text-slate-950 px-2.5 py-1 text-xs font-extrabold shadow-xs">
											🎧 Audio
										</span>
									)}
									<span class="rounded-lg bg-slate-900/80 text-amber-300 px-2.5 py-1 text-xs font-bold backdrop-blur-xs">
										{comic.pageCount} Halaman
									</span>
								</div>

								<!-- Dynamic Bookmark Status Badge -->
								<div
									data-bookmark-badge={comic.slug}
									class="hidden absolute bottom-2.5 left-2.5 rounded-lg bg-emerald-500 text-white px-2.5 py-1 text-xs font-bold shadow-sm"
								>
									Lanjut Baca
								</div>
							</div>

							<!-- Comic Info -->
							<div class="flex-1 flex flex-col justify-between p-5">
								<div>
									<span class="inline-block rounded-md bg-amber-100 text-amber-800 border border-amber-200/80 px-2.5 py-0.5 text-xs font-bold mb-2">
										{comic.badge}
									</span>
									<h3 class="text-lg font-bold text-slate-900 group-hover:text-indigo-600 transition mb-1.5">
										{comic.title}
									</h3>
									<p class="text-sm text-slate-600 line-clamp-2 mb-5">
										{comic.description}
									</p>
								</div>

								<div class="w-full inline-flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-indigo-600 to-violet-600 group-hover:from-amber-500 group-hover:to-orange-500 text-white py-2.5 px-4 font-bold text-sm shadow-2xs transition-all">
									<span data-read-label={comic.slug}>Baca Komik</span>
									<span class="group-hover:translate-x-0.5 transition-transform">→</span>
								</div>
							</div>
						</a>
					))}
				</div>
			)
		}
	</section>

	<script>
		const cards = document.querySelectorAll<HTMLElement>('[data-comic-card]');
		cards.forEach((card) => {
			const slug = card.dataset.comicCard;
			const total = Number(card.dataset.totalPages || 1);
			if (!slug) return;

			const savedPage = Number(localStorage.getItem(`komik_bookmark_${slug}`) || 0);
			if (savedPage > 0 && savedPage < total) {
				const badge = card.querySelector<HTMLElement>(`[data-bookmark-badge="${slug}"]`);
				const label = card.querySelector<HTMLElement>(`[data-read-label="${slug}"]`);
				if (badge) {
					badge.textContent = `Halaman ${savedPage + 1} / ${total}`;
					badge.classList.remove('hidden');
				}
				if (label) {
					label.textContent = `Lanjut Baca (Hal. ${savedPage + 1})`;
				}
			}
		});
	</script>
</Layout>
