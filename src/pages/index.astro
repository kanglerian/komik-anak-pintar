---
import Layout from '../layouts/Layout.astro';
import { getAllComics } from '../lib/comics';

const comics = getAllComics();
---

<Layout title="Komik Anak Pintar — Pilih Komik">
	<!-- Clean, Focused Hero Section -->
	<section class="rounded-2xl bg-indigo-600 text-white p-6 sm:p-10 mb-8 shadow-sm">
		<div class="max-w-2xl">
			<span class="inline-block rounded-full bg-white/15 px-3 py-1 text-xs font-semibold tracking-wide uppercase mb-3">
				Komik Digital Interaktif
			</span>
			<h1 class="text-2xl sm:text-4xl font-bold tracking-tight mb-2.5">
				Pilih Cerita & Balik Halamannya
			</h1>
			<p class="text-sm sm:text-base text-indigo-100 leading-relaxed">
				Sentuh dan geser ujung gambar komik untuk membalik halaman persis seperti membaca buku cerita fisik.
			</p>
		</div>
	</section>

	<!-- Rak Buku Komik -->
	<section>
		<div class="flex items-center justify-between gap-3 mb-5">
			<div>
				<h2 class="text-xl sm:text-2xl font-bold text-slate-900">
					Koleksi Komik ({comics.length})
				</h2>
				<p class="text-sm text-slate-500">
					Pilih salah satu judul di bawah ini untuk mulai membaca
				</p>
			</div>
		</div>

		{
			comics.length === 0 ? (
				<div class="rounded-2xl border-2 border-dashed border-slate-300 bg-white p-10 text-center">
					<h3 class="text-lg font-bold text-slate-900 mb-1">Belum Ada Komik</h3>
					<p class="text-sm text-slate-600 max-w-md mx-auto">
						Buat folder di dalam <code class="bg-slate-100 px-1.5 py-0.5 rounded font-mono">public/comics/nama-komik/</code> lalu masukkan file gambar <code class="bg-slate-100 px-1.5 py-0.5 rounded font-mono">.webp</code>.
					</p>
				</div>
			) : (
				<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
					{comics.map((comic) => (
						<a
							href={`/komik/${comic.slug}`}
							data-comic-card={comic.slug}
							data-total-pages={comic.pageCount}
							class="group flex flex-col rounded-2xl border border-slate-200 bg-white overflow-hidden shadow-xs hover:shadow-lg hover:border-indigo-300 transition-all duration-200"
						>
							<!-- 16:9 Cover Preview -->
							<div class="relative aspect-video w-full bg-slate-900 overflow-hidden">
								<img
									src={comic.coverUrl}
									alt={`Sampul ${comic.title}`}
									loading="lazy"
									class="w-full h-full object-cover group-hover:scale-103 transition-transform duration-300"
								/>

								<!-- Top Page Count Badge -->
								<div class="absolute top-3 right-3">
									<span class="rounded-md bg-slate-900/80 text-white px-2.5 py-1 text-xs font-semibold backdrop-blur-xs">
										{comic.pageCount} Halaman
									</span>
								</div>

								<!-- Dynamic Bookmark Status Badge -->
								<div
									data-bookmark-badge={comic.slug}
									class="hidden absolute bottom-2.5 left-2.5 rounded-md bg-emerald-600 text-white px-2.5 py-1 text-xs font-semibold shadow-sm"
								>
									Lanjut Baca
								</div>
							</div>

							<!-- Comic Info -->
							<div class="flex-1 flex flex-col justify-between p-5">
								<div>
									<span class="inline-block text-xs font-semibold text-indigo-600 mb-1">
										{comic.badge}
									</span>
									<h3 class="text-lg font-bold text-slate-900 group-hover:text-indigo-600 transition mb-1.5">
										{comic.title}
									</h3>
									<p class="text-sm text-slate-600 line-clamp-2 mb-5">
										{comic.description}
									</p>
								</div>

								<div class="w-full inline-flex items-center justify-center gap-2 rounded-xl bg-indigo-600 group-hover:bg-indigo-700 text-white py-2.5 px-4 font-semibold text-sm transition">
									<span data-read-label={comic.slug}>Baca Komik</span>
									<span class="group-hover:translate-x-0.5 transition-transform">→</span>
								</div>
							</div>
						</a>
					))}
				</div>
			)
		}
	</section>

	<script>
		const cards = document.querySelectorAll<HTMLElement>('[data-comic-card]');
		cards.forEach((card) => {
			const slug = card.dataset.comicCard;
			const total = Number(card.dataset.totalPages || 1);
			if (!slug) return;

			const savedPage = Number(localStorage.getItem(`komik_bookmark_${slug}`) || 0);
			if (savedPage > 0 && savedPage < total) {
				const badge = card.querySelector<HTMLElement>(`[data-bookmark-badge="${slug}"]`);
				const label = card.querySelector<HTMLElement>(`[data-read-label="${slug}"]`);
				if (badge) {
					badge.textContent = `Halaman ${savedPage + 1} / ${total}`;
					badge.classList.remove('hidden');
				}
				if (label) {
					label.textContent = `Lanjut Baca (Hal. ${savedPage + 1})`;
				}
			}
		});
	</script>
</Layout>
